{
    // The unique name of your Cloudflare Worker
    "name": "my-cloudflare-worker",

    // The entry point file for your application
    "main": "worker.js",

    // The date defining the runtime compatibility behavior
    "compatibility_date": "2026-10-13",

    // Opt-in flags for experimental or specific platform capabilities
    "compatibility_flags": [
        "nodejs_compat"
    ],

    "ratelimits": [
        {
            "name": "LOGIN_RATE_LIMITER",
            "namespace_id": "1001",
            "simple": {
                "limit": 10,
                "period": 60
            }
        }
    ]
}